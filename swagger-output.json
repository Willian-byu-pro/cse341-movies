{
  "swagger": "2.0",
  "info": {
    "title": "CSE 341 - Movies API",
    "description": "API for managing movies and genres. Built for the Week 03-04 project of CSE 341 (BYU-Idaho). Every route performs validation and error handling. Write operations (POST, PUT, DELETE) require authentication through Auth0; read operations are public.",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "tags": [
    {
      "name": "Movies",
      "description": "Create, read, update and delete movies"
    },
    {
      "name": "Genres",
      "description": "Create, read, update and delete genres"
    },
    {
      "name": "Auth",
      "description": "OAuth 2.0 authentication with Auth0"
    }
  ],
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "cookieAuth": {
      "type": "apiKey",
      "name": "Cookie",
      "in": "header",
      "description": "Session cookie set by GET /auth/callback after a successful Auth0 login. The cookie is httpOnly, so the browser sends it automatically and page scripts cannot read it. Routes marked with a lock require it."
    }
  },
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/auth/login": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Start the login flow",
        "description": "Generates a random state value, stores it in a short lived httpOnly cookie, and redirects the browser to Auth0. The user authenticates on Auth0, so this API never sees their password.",
        "responses": {
          "302": {
            "description": "Redirect to the Auth0 login page."
          }
        }
      }
    },
    "/auth/callback": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "OAuth callback",
        "description": "Auth0 redirects here with a one time authorization code. The server checks the state parameter against the cookie to prevent CSRF, exchanges the code for tokens server to server, creates the user on first login, and sets the httpOnly session cookie.",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "description": "One time authorization code issued by Auth0.",
            "required": true,
            "type": "string"
          },
          {
            "name": "state",
            "in": "query",
            "description": "Random value that must match the oauth_state cookie.",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Logged in. The session cookie is set and the user is returned."
          },
          "400": {
            "description": "Invalid state parameter or missing authorization code."
          },
          "500": {
            "description": "Authentication failed."
          }
        }
      }
    },
    "/auth/logout": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Log out",
        "description": "Clears the session cookie and redirects to Auth0 so the Auth0 session ends as well. Clearing only the local cookie would let the next login skip the password prompt.",
        "responses": {
          "302": {
            "description": "Redirect to the Auth0 logout endpoint."
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get the logged in user",
        "description": "Returns the user carried by the session cookie. This route is only available to authenticated users and is the simplest way to check whether a session is active.",
        "responses": {
          "200": {
            "description": "The authenticated user."
          },
          "401": {
            "description": "Authentication required, or the session is invalid or expired."
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    },
    "/movies/": {
      "get": {
        "tags": [
          "Movies"
        ],
        "summary": "Get all movies",
        "description": "Returns every movie stored in the movies collection.",
        "responses": {
          "200": {
            "description": "An array of movies.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/MovieResponse"
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "post": {
        "tags": [
          "Movies"
        ],
        "summary": "Create a new movie",
        "description": "Creates a movie. All eight fields are required and validated: year must be an integer between 1888 and the current year plus five, duration must be greater than zero, and rating must be between 0 and 10. Returns the new movie id.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Movie to be created.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Movie"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Movie created. The new id is returned in the body."
          },
          "400": {
            "description": "Validation failed. The response lists every invalid field."
          },
          "401": {
            "description": "Authentication required."
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    },
    "/movies/{id}": {
      "get": {
        "tags": [
          "Movies"
        ],
        "summary": "Get a movie by id",
        "description": "Returns the movie that matches the MongoDB _id provided.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB _id of the movie (24 hex characters)."
          }
        ],
        "responses": {
          "200": {
            "description": "The movie found.",
            "schema": {
              "$ref": "#/definitions/MovieResponse"
            }
          },
          "400": {
            "description": "Invalid movie id."
          },
          "404": {
            "description": "Movie not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "put": {
        "tags": [
          "Movies"
        ],
        "summary": "Update an existing movie",
        "description": "Replaces the movie identified by the id. All eight fields are required and validated, exactly as in the create route.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB _id of the movie to update."
          },
          {
            "name": "body",
            "in": "body",
            "description": "New data for the movie.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Movie"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Movie updated successfully. No content returned."
          },
          "400": {
            "description": "Invalid id or validation failed."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Movie not found."
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Movies"
        ],
        "summary": "Delete a movie",
        "description": "Removes the movie identified by the id from the database.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB _id of the movie to delete."
          }
        ],
        "responses": {
          "204": {
            "description": "Movie deleted successfully. No content returned."
          },
          "400": {
            "description": "Invalid movie id."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Movie not found."
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    },
    "/genres/": {
      "get": {
        "tags": [
          "Genres"
        ],
        "summary": "Get all genres",
        "description": "Returns every genre stored in the genres collection.",
        "responses": {
          "200": {
            "description": "An array of genres.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GenreResponse"
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "post": {
        "tags": [
          "Genres"
        ],
        "summary": "Create a new genre",
        "description": "Creates a genre. All four fields are required and validated: name and description must be text, popularity must be a number between 1 and 10, and active must be a boolean (true or false, without quotes). Returns the new genre id.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Genre to be created.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Genre"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Genre created. The new id is returned in the body."
          },
          "400": {
            "description": "Validation failed. The response lists every invalid field."
          },
          "401": {
            "description": "Authentication required."
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    },
    "/genres/{id}": {
      "get": {
        "tags": [
          "Genres"
        ],
        "summary": "Get a genre by id",
        "description": "Returns the genre that matches the MongoDB _id provided.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB _id of the genre (24 hex characters)."
          }
        ],
        "responses": {
          "200": {
            "description": "The genre found.",
            "schema": {
              "$ref": "#/definitions/GenreResponse"
            }
          },
          "400": {
            "description": "Invalid genre id."
          },
          "404": {
            "description": "Genre not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "put": {
        "tags": [
          "Genres"
        ],
        "summary": "Update an existing genre",
        "description": "Replaces the genre identified by the id. All four fields are required and validated, exactly as in the create route.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB _id of the genre to update."
          },
          {
            "name": "body",
            "in": "body",
            "description": "New data for the genre.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Genre"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Genre updated successfully. No content returned."
          },
          "400": {
            "description": "Invalid id or validation failed."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Genre not found."
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Genres"
        ],
        "summary": "Delete a genre",
        "description": "Removes the genre identified by the id from the database.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB _id of the genre to delete."
          }
        ],
        "responses": {
          "204": {
            "description": "Genre deleted successfully. No content returned."
          },
          "400": {
            "description": "Invalid genre id."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Genre not found."
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    }
  },
  "definitions": {
    "Movie": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "City of God"
        },
        "director": {
          "type": "string",
          "example": "Fernando Meirelles"
        },
        "year": {
          "type": "number",
          "example": 2002
        },
        "genre": {
          "type": "string",
          "example": "Crime"
        },
        "duration": {
          "type": "number",
          "example": 130
        },
        "rating": {
          "type": "number",
          "example": 8.6
        },
        "language": {
          "type": "string",
          "example": "Portuguese"
        },
        "synopsis": {
          "type": "string",
          "example": "Two boys growing up in a violent neighborhood of Rio de Janeiro take different paths."
        }
      },
      "required": [
        "title",
        "director",
        "year",
        "genre",
        "duration",
        "rating",
        "language",
        "synopsis"
      ]
    },
    "MovieResponse": {
      "type": "object",
      "properties": {
        "_id": {
          "type": "string",
          "example": "6abae746ccd5884aaa55b26d"
        },
        "title": {
          "type": "string",
          "example": "City of God"
        },
        "director": {
          "type": "string",
          "example": "Fernando Meirelles"
        },
        "year": {
          "type": "number",
          "example": 2002
        },
        "genre": {
          "type": "string",
          "example": "Crime"
        },
        "duration": {
          "type": "number",
          "example": 130
        },
        "rating": {
          "type": "number",
          "example": 8.6
        },
        "language": {
          "type": "string",
          "example": "Portuguese"
        },
        "synopsis": {
          "type": "string",
          "example": "Two boys growing up in a violent neighborhood of Rio de Janeiro take different paths."
        }
      }
    },
    "Genre": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Crime"
        },
        "description": {
          "type": "string",
          "example": "Films centered on criminal activity"
        },
        "popularity": {
          "type": "number",
          "example": 8
        },
        "active": {
          "type": "boolean",
          "example": true
        }
      },
      "required": [
        "name",
        "description",
        "popularity",
        "active"
      ]
    },
    "GenreResponse": {
      "type": "object",
      "properties": {
        "_id": {
          "type": "string",
          "example": "6abafce7ee75cb194596c648"
        },
        "name": {
          "type": "string",
          "example": "Crime"
        },
        "description": {
          "type": "string",
          "example": "Films centered on criminal activity"
        },
        "popularity": {
          "type": "number",
          "example": 8
        },
        "active": {
          "type": "boolean",
          "example": true
        }
      }
    }
  }
}